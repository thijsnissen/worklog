{
    "name": "worklog",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "copy:assets": "cpy \"dist/assets/**/*\" \"./../backend/modules/app/src/main/resources/static/assets/\"",
        "copy:public": "cpy \"dist/public/**/*\" \"./../backend/modules/app/src/main/resources/public/\"",
        "types": "openapi-typescript ./../openapi.json -o static/ts/types/api.d.ts",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && eslint --flag unstable_native_nodejs_ts_config --max-warnings=0 && prettier --check .",
        "normalize": "eslint --flag unstable_native_nodejs_ts_config --fix && prettier --write .",
        "build": "npm run types && npx vite build && npm run copy:assets && npm run copy:public"
    },
    "devDependencies": {
        "@eslint/css": "^1.4.0",
        "@html-eslint/eslint-plugin": "^0.65.0",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "@typescript-eslint/parser": "^8.66.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "cpy-cli": "^7.0.0",
        "eslint": "^10.8.0",
        "globals": "^17.9.0",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.6",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.2.0"
    },
    "dependencies": {
        "lucide": "^1.28.0"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    },
    "allowScripts": {
        "fsevents": true
    }
}
